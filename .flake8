[flake8]
# flake8 does not read pyproject.toml, which is why its config lives here.
max-line-length = 100

# E203 and W503 clash with Black's style (a space before ':' in slices, and a
# line break before a binary operator). Black's own manual disables them.
extend-ignore = E203, W503

exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist,
    *.egg-info

per-file-ignores =
    # The fixtures are HTML copied from the job boards: splitting them would
    # falsify them.
    tests/test_sources.py:E501
