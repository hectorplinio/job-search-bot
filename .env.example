# --- Telegram ---------------------------------------------------------------
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Tu chat id. Escribe a @userinfobot para obtenerlo, o usa `jobbot chat-id`.
TELEGRAM_CHAT_ID=123456789

# --- Anthropic --------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Credenciales de los portales (opcional) --------------------------------
# Solo las usa `jobbot login --auto` para rellenar el formulario dentro de un
# navegador real. No se mandan a ningun sitio mas y no salen en los logs.
#
# Si el portal pide captcha o 2FA, el login automatico se para y te deja
# entrar tu en la ventana: eso pasa una vez, y el perfil del navegador
# recuerda la sesion durante semanas.
#
# Si prefieres no guardar contrasenas en un fichero, dejalas vacias y usa
# `jobbot login` sin --auto: entras a mano y funciona igual.
INFOJOBS_USER=
INFOJOBS_PASSWORD=
GLASSDOOR_USER=
GLASSDOOR_PASSWORD=
OTTA_USER=
OTTA_PASSWORD=

# --- Cookies de sesion (opcional, alternativa manual) -----------------------
# Normalmente NO hace falta tocar esto: `jobbot login` guarda las cookies solo
# en data/cookies.json, con su fecha de caducidad. Estas variables son para
# pegarlas a mano si prefieres no instalar el navegador.
#
# Son secretos: quien tenga esta cadena entra en tu cuenta sin contrasena y
# sin segundo factor. .env esta en .gitignore, dejalo asi.
#
# Como sacarlas a mano: abre el portal logueado, F12 -> pestana Network ->
# recarga -> click en la primera peticion del documento -> Request Headers ->
# copia el valor entero de "Cookie".
#
# Despues de ponerlas, comprueba que funcionan:  jobbot check-sources
#
# InfoJobs: recomendado. Sin sesion corta por IP y devuelve paginas vacias.
INFOJOBS_COOKIE=
# Glassdoor: recomendado. Sin sesion responde 403 a las pocas peticiones.
GLASSDOOR_COOKIE=
# Otta / Welcome to the Jungle: esta detras de AWS WAF con reto de JavaScript.
# La cookie tiene que incluir tambien el "aws-waf-token", y ese caduca en
# minutos. Vale para una prueba, no para dejarlo en el cron. Ver README.
OTTA_COOKIE=
# LinkedIn: NO recomendado. El endpoint de invitado ya devuelve los mismos
# resultados sin arriesgar nada, y LinkedIn restringe cuentas por acceso
# automatizado. Perder el perfil buscando trabajo sale caro. Ver README.
LINKEDIN_COOKIE=

# --- Opcional ---------------------------------------------------------------
# Ruta de la base de datos de historial.
JOBBOT_DB_PATH=data/jobs.sqlite3
# Ruta del fichero de perfil/criterios.
JOBBOT_CONFIG_PATH=config.yaml
# Nivel de log: DEBUG, INFO, WARNING, ERROR
JOBBOT_LOG_LEVEL=INFO
