# --- Telegram ---------------------------------------------------------------
# The token @BotFather gives you when you create the bot.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Your chat id. Message @userinfobot to get it, or run `jobbot chat-id`.
TELEGRAM_CHAT_ID=123456789

# --- Anthropic --------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Job board credentials (optional) ---------------------------------------
# Only `jobbot login --auto` uses them, to fill in the form inside a real
# browser. They are sent nowhere else and never appear in the logs.
#
# If the site asks for a captcha or 2FA, the automatic login stops and lets you
# sign in yourself in the window: that happens once, and the browser profile
# remembers the session for weeks.
#
# If you would rather not keep passwords in a file, leave them empty and use
# `jobbot login` without --auto: you sign in by hand and it works the same.
INFOJOBS_USER=
INFOJOBS_PASSWORD=
GLASSDOOR_USER=
GLASSDOOR_PASSWORD=
OTTA_USER=
OTTA_PASSWORD=

# --- Salary (optional) ------------------------------------------------------
# These override salary.minimum and salary.target from config.yaml. They live
# here because config.yaml is published in the repo and your negotiating
# figures should not be. Left empty, the YAML values win.
JOBBOT_SALARY_MINIMUM=
JOBBOT_SALARY_TARGET=

# --- Session cookies (optional, the manual alternative) ---------------------
# You normally do NOT need to touch this: `jobbot login` stores the cookies in
# data/cookies.json on its own, with their expiry date. These variables are for
# pasting them by hand if you would rather not install the browser.
#
# They are secrets: whoever holds this string gets into your account with no
# password and no second factor. .env is in .gitignore, keep it that way.
#
# How to get them by hand: open the site while signed in, F12 -> Network tab ->
# reload -> click the first document request -> Request Headers -> copy the
# whole value of "Cookie".
#
# Once they are in, check that they work:  jobbot check-sources
#
# InfoJobs: recommended. Without a session it blocks your IP and serves empty pages.
INFOJOBS_COOKIE=
# Glassdoor: recommended. Without a session it answers 403 after a few requests.
GLASSDOOR_COOKIE=
# Otta / Welcome to the Jungle: it sits behind AWS WAF with a JavaScript
# challenge. The cookie also has to include the "aws-waf-token", and that one
# expires in minutes. Fine for a test, not for leaving in the cron. See README.
OTTA_COOKIE=
# LinkedIn: NOT recommended. The guest endpoint already returns the same
# results without risking anything, and LinkedIn restricts accounts over
# automated access. Losing your profile while job hunting is expensive. See README.
LINKEDIN_COOKIE=

# --- Optional ---------------------------------------------------------------
# Path to the history database.
JOBBOT_DB_PATH=data/jobs.sqlite3
# Path to the criteria file.
JOBBOT_CONFIG_PATH=config.yaml
# Log level: DEBUG, INFO, WARNING, ERROR
JOBBOT_LOG_LEVEL=INFO
