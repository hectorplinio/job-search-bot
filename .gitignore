.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
out/

# Everything in data/ is yours and private: the history, the session cookies
# and the browser profile with your accounts signed in. The whole folder is
# ignored except the .gitkeep, so a new file cannot escape because someone
# forgot to add it here.
data/*
!data/.gitkeep

# The CV carries a phone number and an email. In a public repo Google indexes
# that and it ends up on spam lists.
*.pdf
*.docx

# Local editor preferences, not the project's.
.claude/settings.local.json
